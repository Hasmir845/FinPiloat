# Server Port
PORT=5001

# Environment Mode
NODE_ENV=development

# Allowed Frontend Client Origins for CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas Database Connection
# Safe template: Replace with your actual credentials in local .env (never commit real credentials).
# Connection string format:
# mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
MONGODB_DB_NAME=finpilot

# Google Gemini API Configuration (Backend-only - Never expose to client)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
